# Configuration d'agenda_sync.py — format KEY='valeur', une clé par ligne.
# Copier hors du dépôt (chemin par défaut : /opt/agenda-sync/agenda-sync-creds),
# ou indiquer un autre chemin dans la variable d'environnement AGENDA_SYNC_CONFIG.
# chmod 600, propriétaire = l'utilisateur qui exécute le cron.

# --- Source (API REST du planning) ---
SOURCE_AUTH_URL='CHANGE_ME'
SOURCE_AGENDA_URL='CHANGE_ME'
SOURCE_USER='CHANGE_ME'
SOURCE_PASSWORD='CHANGE_ME'
# Facultatif : User-Agent envoyé à la source (défaut : agenda-sync)
#SOURCE_USER_AGENT='CHANGE_ME'

# --- Plage synchronisée (AAAA-MM-JJ, UTC) ---
RANGE_START='CHANGE_ME'
RANGE_END='CHANGE_ME'

# --- Destination CalDAV ---
CALDAV_URL='https://cloud.example.lan/remote.php/dav'
CALDAV_USER='CHANGE_ME'
CALDAV_PASSWORD='CHANGE_ME'
CALENDAR_NAME='Cours'

# --- Notifications ntfy ---
NTFY_URL='https://ntfy.example.lan'
NTFY_TOKEN='CHANGE_ME'
#NTFY_TOPIC_FAILURE='sync-errors'
#NTFY_TOPIC_CHANGES='sync-changes'

# --- Divers (facultatif) ---
#LOG_FILE='/opt/agenda-sync/logs/agenda-sync.log'
#UID_DOMAIN='agenda-sync'
